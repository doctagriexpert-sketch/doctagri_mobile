# DoctAgri — Variables d'environnement
# =====================================================
# Copie ce fichier vers .env et remplis les valeurs.
# NE JAMAIS committer le fichier .env avec de vraies clés.
# =====================================================

# ── Supabase ──────────────────────────────────────────
# Disponible dans : Supabase Dashboard > Settings > API
# Utilisées en --dart-define au moment du build Flutter.
SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── HuggingFace (NLLB-200 traduction Ewe) ─────────────
# Créer un token sur : https://huggingface.co/settings/tokens
# À injecter comme secret Supabase (PAS dans le code Flutter) :
#   supabase secrets set HF_API_TOKEN=hf_...
HF_API_TOKEN=hf_your_token_here

# ── OpenWeather (météo agricole — Phase 2) ────────────
# Clé gratuite sur : https://openweathermap.org/api
OPEN_WEATHER_API_KEY=your_api_key_here
